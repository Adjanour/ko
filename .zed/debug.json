[
  {
    "label": "Debug tokenizer invalid-byte tests",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/zig-out/bin/tokenizer-tests",
    "cwd": "$ZED_WORKTREE_ROOT",
    "build": {
      "command": "zig",
      "args": [
        "test",
        "src/tokenizer.zig",
        "--test-filter",
        "invalid",
        "-femit-bin=zig-out/bin/tokenizer-tests",
        "--test-cmd",
        "true",
        "--test-cmd-bin"
      ]
    }
  }
]
